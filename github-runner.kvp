Meta.DisplayName=GitHub Actions Runner
Meta.Description=Eigener GitHub-Runner für Builds und Automationen. Die Anmeldung bei GitHub erfolgt einmalig per SSH.
Meta.OS=Linux
Meta.AarchSupport=Native
Meta.Arch=x86_64
Meta.Author=BlueIceWolf
Meta.URL=https://github.com/actions/runner
Meta.DisplayImageSource=none:
Meta.ConfigManifest=github-runnerconfig.json
Meta.MetaConfigManifest=github-runnermetaconfig.json
Meta.ConfigRoot=github-runner.kvp
Meta.MinAMPVersion=2.8.0.4
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.ConfigVersion=1
Meta.AppConfigId=3c499276-1f85-490c-85af-3b492c63da10
App.DisplayName=GitHub Actions Runner
App.RootDir=./github-runner/
App.BaseDirectory=./github-runner/
App.ExecutableLinux=bin/Runner.Listener
App.WorkingDir=.
App.CommandLineArgs=run
App.AppSettings={}
App.EnvironmentVariables={}
App.ExitMethod=OS_CLOSE
App.ExitTimeout=60
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.Ports=@IncludeJson[github-runnerports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=0
App.AdminMethod=STDIO
App.UpdateSources=@IncludeJson[github-runnerupdates.json]
App.RapidStartup=False
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^.*Listening for Jobs.*$
Console.FilterMatchRegex=
Console.ThrowawayMessageRegex=
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=2
